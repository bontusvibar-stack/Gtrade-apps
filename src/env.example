# Copy this file to ".env" and fill in the values from your own Supabase project
# (Project Settings -> API in the Supabase dashboard).
#
# VITE_SUPABASE_URL is the "Project URL".
# VITE_SUPABASE_ANON_KEY is the "anon public" key — this is safe to expose in
# the frontend, it is NOT the service-role key. Never put the service-role
# key in this file or anywhere in the frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by the "revoke device session" flow to build the correct
# function URL. Same value as VITE_SUPABASE_URL, kept separate so it's clear
# what it's for.
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.functions.supabase.co
